<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SonarHotkeys.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SonarHotkeys">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar: the content extends into it. -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="16" Height="16" />
                <TextBlock Text="SonarHotkeys" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="24,4,24,0" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock x:Name="HeadingText" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="HelpText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <!-- A menu button rather than a ComboBox: a ComboBox opens so that the selected item covers it,
                 which pushed the list upwards whenever English was selected. -->
            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                <TextBlock Text="Язык / Language" />
                <DropDownButton x:Name="LanguageButton" Width="160" HorizontalContentAlignment="Left">
                    <DropDownButton.Flyout>
                        <!-- Filled from the available text catalogs. -->
                        <MenuFlyout x:Name="LanguageMenu" Placement="BottomEdgeAlignedLeft">
                            <!-- As wide as the button. -->
                            <MenuFlyout.MenuFlyoutPresenterStyle>
                                <Style TargetType="MenuFlyoutPresenter">
                                    <Setter Property="MinWidth" Value="160" />
                                    <Setter Property="MaxWidth" Value="160" />
                                </Style>
                            </MenuFlyout.MenuFlyoutPresenterStyle>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Padding="24,20,24,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RefreshButton" Click="OnRefresh">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock x:Name="RefreshText" />
                    </StackPanel>
                </Button>
                <Button x:Name="AddButton" Click="OnAdd">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Name="AddText" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <ToggleSwitch x:Name="AutostartSwitch" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" Toggled="OnAutostartToggled" />
        </Grid>

        <Grid Grid.Row="3">
            <ListView x:Name="RowsList" ItemsSource="{x:Bind Rows}" SelectionMode="None" Padding="12,0,12,0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:BindingRow">
                        <Grid Padding="16,12,16,14" ColumnSpacing="12" CornerRadius="8" BorderThickness="1"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="{x:Bind PresetHeader, Mode=OneWay}" PlaceholderText="{x:Bind PresetPlaceholder, Mode=OneWay}"
                                      ItemsSource="{x:Bind Presets, Mode=OneWay}" SelectedItem="{x:Bind Preset, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:ChoiceItem">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox Grid.Column="1" Header="{x:Bind DeviceHeader, Mode=OneWay}"
                                      ItemsSource="{x:Bind Devices, Mode=OneWay}" SelectedItem="{x:Bind Device, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:ChoiceItem">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Grid.Column="2" Header="{x:Bind HotkeyHeader, Mode=OneWay}" PlaceholderText="{x:Bind HotkeyPlaceholder, Mode=OneWay}"
                                     Text="{x:Bind Hotkey, Mode=OneWay}" IsReadOnly="True"
                                     PreviewKeyDown="OnHotkeyKeyDown" GotFocus="OnHotkeyFocus" LostFocus="OnHotkeyLostFocus" />
                            <Button Grid.Column="3" VerticalAlignment="Bottom" Height="32" Click="OnApplyRow"
                                    ToolTipService.ToolTip="{x:Bind ApplyLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ApplyLabel, Mode=OneWay}">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" />
                            </Button>
                            <Button Grid.Column="4" VerticalAlignment="Bottom" Height="32" Click="OnRemoveRow"
                                    ToolTipService.ToolTip="{x:Bind RemoveLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind RemoveLabel, Mode=OneWay}">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                       MaxWidth="440" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Grid Grid.Row="4" Margin="24,8,24,20" Padding="16,12" ColumnSpacing="12" CornerRadius="8" BorderThickness="1"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CycleLabel" VerticalAlignment="Center" />
            <TextBox x:Name="CycleBox" Grid.Column="1" IsReadOnly="True" Width="260" HorizontalAlignment="Left"
                     PreviewKeyDown="OnHotkeyKeyDown" GotFocus="OnHotkeyFocus" LostFocus="OnHotkeyLostFocus" />
            <Button x:Name="NextButton" Grid.Column="2" Click="OnNext">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                    <TextBlock x:Name="NextText" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Floats over the bottom of the list, so showing or hiding it never moves the content.
             A solid backing, since the InfoBar's own background is translucent. -->
        <Border x:Name="StatusPanel" Grid.Row="3" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                Margin="24,0,24,12" CornerRadius="4" BorderThickness="1" Canvas.ZIndex="1"
                Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <InfoBar x:Name="Status" IsOpen="True" IsClosable="True" Closing="OnStatusClosing" />
        </Border>
    </Grid>
</Window>
