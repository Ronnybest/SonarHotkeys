<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SonarHotkeys</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- One file per language, found at run time as SonarHotkeys.Strings.<code>.json. -->
    <EmbeddedResource Include="Strings\*.json" LogicalName="SonarHotkeys.Strings.%(Filename).json" />
    <PackageReference Include="Steelseries-NET-API" Version="2.0.0" />
  </ItemGroup>

</Project>
